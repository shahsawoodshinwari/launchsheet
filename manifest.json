{
  "manifest_version": 3,
  "name": "Launchsheet",
  "version": "0.1.0",
  "description": "Create and update App Store Connect apps from a CSV spreadsheet. Google Play coming soon.",
  "homepage_url": "https://github.com/shahsawoodshinwari/launchsheet",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": ["https://appstoreconnect.apple.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel/panel.html" },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Launchsheet",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-48.png" }
  }
}
